<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stream_settings"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Stream at locked 30 FPS and 1000 kbps"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- RTMP Server URL -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="RTMP URL / Server"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etRtmpUrl"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="#242C3D"
        android:hint="@string/rtmp_url_hint"
        android:inputType="textUri"
        android:paddingHorizontal="12dp"
        android:textColor="@color/white"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Stream Key -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Stream Key"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etStreamKey"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="#242C3D"
        android:hint="@string/stream_key_hint"
        android:inputType="textPassword"
        android:paddingHorizontal="12dp"
        android:textColor="@color/white"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Quick Presets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPresetVps"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VPS Relay"
            android:textColor="@color/accent_blue"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnPresetYouTube"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="YouTube Live"
            android:textColor="@color/accent_blue"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Save Button -->
    <Button
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/accent_blue"
        android:text="@string/save"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="8dp" />
</LinearLayout>
