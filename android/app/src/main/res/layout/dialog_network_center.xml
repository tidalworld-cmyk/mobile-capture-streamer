<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_network_cell"
            app:tint="@color/accent_blue" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="BondStream Network Center"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseNetworkCenter"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Overall Bonding Status Banner Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCenterBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#10B981"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="BONDED (2)"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCenterSummary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="2 Networks Connected"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCenterBandwidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:text="Total Avail: 45.0 Mbps | Usage: 2.5 Mbps"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvCenterSentLoss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:text="Sent: 14.8 MB | 38ms RTT | 0.0% loss"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Scrollable Section: Each Wi-Fi and SIM Interface in Separate Cards -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="6dp"
        android:text="PHYSICAL INTERFACES"
        android:textColor="@color/text_secondary"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/layoutNetworkCards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Dynamic interface cards injected here at runtime -->
        </LinearLayout>
    </ScrollView>

    <!-- Benchmark Action Button -->
    <Button
        android:id="@+id/btnCenterBenchmark"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#334155"
        android:text="Run Multi-Path Benchmark Test"
        android:textColor="@color/white"
        android:textSize="11.5sp"
        app:cornerRadius="6dp" />

    <TextView
        android:id="@+id/tvCenterBenchmarkResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/accent_green"
        android:textSize="10.5sp"
        android:visibility="gone" />

    <!-- DSDS Notice / Carrier Concurrency status -->
    <TextView
        android:id="@+id/tvCenterNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:visibility="gone" />

</LinearLayout>
